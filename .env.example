# AI for reading photos and building help ladders. Add ONE of the keys.
# Without a key the site works with built-in tasks and typed examples only.

# Google Gemini — free tier available: https://aistudio.google.com → Get API key.
# On the free tier Google may use the data to improve its products; check the terms.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_READ_MODEL=gemini-flash-lite-latest

# Claude — paid per use: https://platform.claude.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# If both keys are set, Gemini is main and Claude answers only when Gemini is busy.
# To use one AI only: AI_PROVIDER=gemini (no Claude backup) or AI_PROVIDER=claude
# AI_PROVIDER=

# Cloud database (Supabase). The Vercel integration sets it automatically.
# Ready lessons are saved there and reused for every child.
# POSTGRES_URL=
# Textbook PDFs (Supabase Storage). Also set by the Vercel integration.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
